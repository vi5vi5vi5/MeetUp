# Артефакты сборки
build/
out/

# Собранный веб-клиент: его заново делает стадия сборки образа
# (`node web/tools/build.js`), локальная копия в контекст не нужна.
# ВНИМАНИЕ: правило `tools/` ниже относится ТОЛЬКО к каталогу в корне
# контекста — `web/tools/` со сборщиком в образ попадает, и должен.
web/dist/

# Данные сервера (SQLite): монтируются томом (см. docker-compose.yml),
# в контекст сборки и образ не попадают
mount/

# IDE / локальные настройки
.vs/
.claude/
*.user

# Windows-специфичные скрипты и пресеты (в контейнере не нужны,
# содержат зашитые пути P:\Qt\... — только сбивают cmake)
build.ps1
run.ps1
CMakePresets.json
CMakeUserPresets.json

# История и документация в образ не кладём
.git/
docs/

# Сам докер-контекст
Dockerfile
.dockerignore
docker-compose.yml

# У прокси свой контекст сборки (proxy/), в образ приложения он не нужен
proxy/
tools/

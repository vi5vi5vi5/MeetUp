# Сборка
/build/
/.claude/

# Собранный веб-клиент: web/dist собирается из web/ сборщиком
# web/tools/build.js — в репозитории хранится исходник, а не результат.
/web/dist/

# Данные сервера: база SQLite и meetup.conf. Создаются сами,
# git pull их не трогает.
/mount/

# Домен, почта для Let's Encrypt и порты хоста: файл пишет tools/update.sh,
# docker compose читает его сам. Это настройки конкретной установки —
# в репозитории им делать нечего.
/.env

# Visual Studio
/.vs/
*.vcxproj.user
*.user

# Локальные настройки Claude Code
.claude/settings.local.json

# server-блоки соседних сервисов на этом же сервере (Ferry и т.п.).
# Это настройка конкретной установки, а не код: у каждого свои домены.
# Сам каталог нужен всегда — его держит .gitkeep.
proxy/extra/*.conf

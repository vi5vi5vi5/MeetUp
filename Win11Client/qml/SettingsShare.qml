import QtQuick
import MeetUp

// Раздел «Демонстрация». Отдельно от камеры не для порядка, а по существу:
// на экране читают текст, а не смотрят на лицо, поэтому разрешение и частоту
// кадров выбирают порознь, а кодеки ведут себя иначе, чем на видео с камеры.
Column {
    id: page
    width: parent ? parent.width : 0
    spacing: 18

    Row {
        width: parent.width
        spacing: 8

        Field {
            width: (parent.width - 8) / 2
            label: "Разрешение"
            SettingsCombo {
                width: parent.width
                model: [ { id: "360",  label: "360p" },
                         { id: "480",  label: "480p" },
                         { id: "720",  label: "720p" },
                         { id: "1080", label: "1080p" },
                         { id: "src",  label: "Источник" } ]
                selectedId: AV.screenRes
                onPicked: function (id) { AV.screenRes = id }
            }
        }
        Field {
            width: (parent.width - 8) / 2
            label: "Частота кадров"
            SettingsCombo {
                width: parent.width
                // valueRole у комбо строковый — число приводим на месте.
                // 60 к/с снова доступны: свой захват (ScreenCapturer поверх
                // Windows.Graphics.Capture) отдаёт кадры с частотой обновления
                // монитора, а не 27 к/с по таймеру, как было у Qt.
                model: [ { id: "15", label: "15 к/с" },
                         { id: "30", label: "30 к/с" },
                         { id: "60", label: "60 к/с" } ]
                selectedId: String(AV.screenFps)
                onPicked: function (id) { AV.screenFps = parseInt(id) }
            }
        }
    }

    // Битрейт отдельной строкой, а не в паре: у него длинные подписи, и он
    // единственный, чей смысл зависит от того, кто и где поднял сервер.
    Field {
        width: parent.width
        label: "Битрейт демонстрации"
        readonly property var hints: ({
            "auto":  "Считается от разрешения и частоты, с прицелом на обычный интернет. Разумный выбор, если не уверены.",
            "500":   "Крайний режим для плохой связи: слайды и крупный текст. Движение развалится, но связь не оборвётся.",
            "1000":  "Мобильный интернет и слабый Wi-Fi. Документы и код разборчивы, видео мылит, зато не встаёт.",
            "2000":  "Уверенный минимум для текста и слайдов. Видео будет сыпаться на движении.",
            "5000":  "1080p с запасом для документов и кода, видео — приемлемо.",
            "10000": "1080p60 без компромиссов, 1440p комфортно.",
            "20000": "4K30 или очень чистый 1080p60. Для домашней сети.",
            "40000": "4K60 с хорошим запасом. Гигабитная сеть обязательна.",
            "80000": "Предел разумного: 4K60 практически без потерь. Только для локальной сети."
        })
        hint: (hints[AV.screenBitrate] || "")
              + " Это потолок: если канал не потянет, качество опустится само."
        SettingsCombo {
            width: parent.width
            model: [ { id: "auto",  label: "Авто" },
                     { id: "500",   label: "0,5 Мбит/с" },
                     { id: "1000",  label: "1 Мбит/с" },
                     { id: "2000",  label: "2 Мбит/с" },
                     { id: "5000",  label: "5 Мбит/с" },
                     { id: "10000", label: "10 Мбит/с" },
                     { id: "20000", label: "20 Мбит/с" },
                     { id: "40000", label: "40 Мбит/с" },
                     { id: "80000", label: "80 Мбит/с" } ]
            selectedId: AV.screenBitrate
            onPicked: function (id) { AV.screenBitrate = id }
        }
    }

    // Пока демонстрация идёт, вместо общих слов показываем измеренное: сколько
    // кадров реально уходит. Настройка — это просьба, а не обещание: потолок
    // задаёт частота обновления монитора, выше неё кадров взяться неоткуда.
    Field {
        width: parent.width
        hint: Stats.txScrFormat === ""
            ? "«Источник» отдаёт кадр без масштабирования. Больше кадров — плавнее курсор и видео, выше нагрузка и расход канала. Выше частоты обновления вашего монитора не получится: кадров просто не существует."
            : ("Сейчас уходит " + Stats.txScrFps + " к/с из " + AV.screenFps + " запрошенных"
               + (Stats.txScrFps < AV.screenFps - 3
                  ? " — упирается либо в частоту монитора, либо в канал (см. «Диагностику»)." : "."))
    }

    // Выбора кодека здесь больше нет — ни у демонстрации, ни у камеры.
    //
    // Он был, и его убрали не ради чистоты интерфейса. Замер всех кодеков на
    // живом железе показал, что верхний ответ один и тот же для любой машины,
    // а спуск ниже нужен ровно в одном случае — когда собеседник говорит, что
    // не понимает. Этот случай программа узнаёт сама и раньше человека.
    // Оставлять вопрос, у которого один правильный ответ, значит перекладывать
    // на человека решение, принять которое он не может: цифр у него нет и взять
    // их неоткуда.
    //
    // Что вещается на самом деле, видно в «Диагностике» — там это факт, а не
    // настройка, и место ему именно там.
    Field {
        width: parent.width
        label: "Кодек"
        hint: "Подбирается сам. Сначала HEVC — он даёт то же качество втрое экономнее по каналу и кодируется видеокартой. Если кто-то из участников его не понимает, демонстрация сама перейдёт на H.264, а в крайнем случае на VP8; вы увидите сообщение. Обратно поднимемся в следующей комнате."
    }

    SettingSwitch {
        label: "Показывать курсор"
        description: "Курсор в кадр добавляет сама система — и для монитора, и для отдельного окна. Переключается на лету, демонстрация при этом не прерывается."
        checked: AV.screenCursor
        onToggled: function (v) { AV.screenCursor = v }
    }

    Rectangle { width: parent.width; height: 1; color: Theme.border }

    // Звук демонстрации идёт отдельной полосой (тип кадра 8), и захватывается
    // он в режиме «всё, кроме нас самих» — поэтому голоса собеседников из
    // наших динамиков в него не попадают и эха у них не будет.
    // Только тумблер: громкости здесь больше нет. Она переехала на саму сцену
    // демонстрации, к слушателю, — потому что уровень фонограммы у каждого
    // свой, а отсюда его выбирал ведущий сразу за всю комнату.
    // Что именно попадёт в звук, зависит от источника, и человеку это надо
    // сказать до включения, а не после. Показываем окно — берём звук только
    // его приложения; показываем монитор — всё, что играет машина.
    SettingSwitch {
        label: "Передавать звук компьютера"
        description: Screens.selectedKey.startsWith("window:")
            ? "Только звук показываемого приложения — музыка из плеера и уведомления в него не попадут. Windows делит звук по программам, а не по окнам: у браузера это будут все его вкладки сразу."
            : "Видео, музыка, звук игры — то, что слышите вы. Ваши собеседники в этот звук не попадают, а громкость каждый из них подбирает себе сам."
        checked: AV.screenAudio
        onToggled: function (v) { AV.screenAudio = v }
    }
}

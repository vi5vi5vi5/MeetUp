import QtQuick
import MeetUp

// Раздел «Демонстрация». Отдельно от камеры не для порядка, а по существу:
// на экране читают текст, а не смотрят на лицо, поэтому разрешение и частоту
// кадров выбирают порознь, а кодеки ведут себя иначе, чем на видео с камеры.
Column {
    id: page
    width: parent ? parent.width : 0
    spacing: 18

    Row {
        width: parent.width
        spacing: 8

        Field {
            width: (parent.width - 8) / 2
            label: "Разрешение"
            SettingsCombo {
                width: parent.width
                model: [ { id: "360",  label: "360p" },
                         { id: "480",  label: "480p" },
                         { id: "720",  label: "720p" },
                         { id: "1080", label: "1080p" },
                         { id: "src",  label: "Источник" } ]
                selectedId: AV.screenRes
                onPicked: function (id) { AV.screenRes = id }
            }
        }
        Field {
            width: (parent.width - 8) / 2
            label: "Частота кадров"
            SettingsCombo {
                width: parent.width
                // valueRole у комбо строковый — число приводим на месте.
                // 60 к/с недоступны, но из списка не убраны: захват экрана в
                // Windows через Qt отдаёт около 27 к/с (замерено), сколько бы
                // ни просили, — а вот битрейт под 60 к/с считался в полтора
                // раза выше и уходил в никуда. Вернём, когда появится свой
                // захват; до тех пор честнее показать вариант приглушённым,
                // чем тихо его выкинуть.
                model: [ { id: "15", label: "15 к/с" },
                         { id: "30", label: "30 к/с" },
                         { id: "60", label: "60 к/с", soon: true } ]
                selectedId: String(AV.screenFps)
                onPicked: function (id) { AV.screenFps = parseInt(id) }
            }
        }
    }

    // Пока демонстрация идёт, вместо общих слов показываем измеренное: сколько
    // кадров реально уходит. Настройка — это просьба, а не обещание: столько,
    // сколько отдаёт захват экрана Windows, и не больше. На 4K-мониторе это
    // около 30 к/с (замерено), сколько бы ни просили.
    Field {
        width: parent.width
        hint: Stats.txScrFormat === ""
            ? "«Источник» отдаёт кадр без масштабирования. Больше кадров — плавнее курсор и видео, выше нагрузка. Выше 30 к/с большой экран обычно не отдаёт — это ограничение захвата, а не настройки."
            : ("Сейчас уходит " + Stats.txScrFps + " к/с из " + AV.screenFps + " запрошенных"
               + (Stats.txScrFps < AV.screenFps - 3
                  ? " — быстрее не отдаёт захват экрана Windows." : "."))
    }

    Field {
        width: parent.width
        label: "Кодек демонстрации"
        // Подпись меняется вместе с выбором: у каждого кодека своя цена, и
        // называть её надо в момент выбора, а не в общем абзаце, который
        // прочитают один раз. Формула у всех одна: когда уместен — чем платим.
        readonly property var hints: ({
            "auto": "Начинаем с H.264, при неудаче VP8. Так вас увидят и в браузере, и в старом клиенте — и только этот путь умеет кодировать видеокартой.",
            "h264": "Единственный, который кодирует видеокарта: вчетверо дешевле прочих и ровнее всех по частоте кадров. На мелком шрифте мылит сильнее.",
            "vp8":  "Запасной вариант там, где H.264 нет. Только процессором. Текст читается хуже, чем у VP9.",
            "vp9":  "Чище всех рисует мелкий шрифт и графики при том же канале — но только процессором и вчетверо медленнее H.264 (замерено). На большом экране не успевает и превышает заданный битрейт: кадры начинают скакать, картинка рвётся. Для видео и быстрой динамики не годится.",
            "av1":  "Сжимал бы лучше VP9, но пока выключен — приём готовится."
        })
        hint: hints[AV.screenCodec] || ""
        SegmentedControl {
            width: parent.width
            current: AV.screenCodec
            model: [ { id: "auto", label: "Авто" },
                     { id: "h264", label: "H.264" },
                     { id: "vp8",  label: "VP8" },
                     { id: "vp9",  label: "VP9" },
                     { id: "av1",  label: "AV1", soon: true } ]
            onPicked: function (id) { AV.screenCodec = id }
        }
    }

    SettingSwitch {
        label: "Показывать курсор"
        description: "Мы дорисовываем стрелку сами — захват монитора её не отдаёт. При показе отдельного окна курсор рисует система, и настройка на него не влияет."
        checked: AV.screenCursor
        onToggled: function (v) { AV.screenCursor = v }
    }

    Rectangle { width: parent.width; height: 1; color: Theme.border }

    // Звук демонстрации идёт отдельной полосой (тип кадра 8), и захватывается
    // он в режиме «всё, кроме нас самих» — поэтому голоса собеседников из
    // наших динамиков в него не попадают и эха у них не будет.
    // Только тумблер: громкости здесь больше нет. Она переехала на саму сцену
    // демонстрации, к слушателю, — потому что уровень фонограммы у каждого
    // свой, а отсюда его выбирал ведущий сразу за всю комнату.
    SettingSwitch {
        label: "Передавать звук компьютера"
        description: "Видео, музыка, звук игры — то, что слышите вы. Ваши собеседники в этот звук не попадают, а громкость каждый из них подбирает себе сам."
        checked: AV.screenAudio
        onToggled: function (v) { AV.screenAudio = v }
    }
}
